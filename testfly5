local clientData = require(game.ReplicatedStorage.ClientModules.Core.ClientData)

local function getPlayerData()
    return clientData.get_data()[tostring(game.Players.LocalPlayer)]
end

local function getRidePotions()
    local potions = {}
    for _, item in pairs(getPlayerData().inventory.food or {}) do
        if item.kind == "pet_riding_potion" then
            table.insert(potions, item)
        end
    end
    return potions
end

local function getFlyPotions()
    local potions = {}
    for _, item in pairs(getPlayerData().inventory.food or {}) do
        if item.kind == "pet_flying_potion" then
            table.insert(potions, item)
        end
    end
    return potions
end

local function getMegaNeonUnicornsNeedUpgrade()
    local pets = {}

    for _, pet in pairs(getPlayerData().inventory.pets or {}) do
        local props = pet.properties or {}

        if pet.kind == "unicorn"
            and props.mega_neon
            and (not props.flyable or not props.rideable) then
            table.insert(pets, pet)
        end
    end

    return pets
end

local function ageup(pet, flyPotion, ridePotion)
    if not pet then
        warn("[ageup] pet is nil")
        return false
    end

    game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(pet.unique, {use_sound_delay = true})
    task.wait(0.2)

    print("===== AGEUP START =====")
    print("Pet unique:", pet.unique)
    print("Pet kind:", pet.kind)

    if flyPotion then
        print("Fly potion unique:", flyPotion.unique)
        print("Fly potion kind:", flyPotion.kind)
        game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(flyPotion.unique, {use_sound_delay = true})
        task.wait(0.2)

        local ok, err = pcall(function()
        game.ReplicatedStorage.API["PetObjectAPI/CreatePetObject"]:InvokeServer(
            "__Enum_PetObjectCreatorType_2",
            {
                additional_consume_uniques = potionUniques,
                pet_unique = pet.unique,
                unique_id = flyPotion.unique
            }
        )
        end)
        if not ok then continue end

    else
        print("Fly potion: nil")
    end

    task.wait(5)

    if ridePotion then
        print("Ride potion unique:", ridePotion.unique)
        print("Ride potion kind:", ridePotion.kind)

        game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(ridePotion.unique, {use_sound_delay = true})
        task.wait(0.2)

        local ok, err = pcall(function()
        game.ReplicatedStorage.API["PetObjectAPI/CreatePetObject"]:InvokeServer(
            "__Enum_PetObjectCreatorType_2",
            {
                additional_consume_uniques = potionUniques,
                pet_unique = pet.unique,
                unique_id = ridePotion.unique
            }
        )
        end)
        if not ok then continue end
    else
        print("Ride potion: nil")
    end

    task.wait(5)

    print("===== AGEUP END =====")
    return true
end


local function printOneStep(step)
    local pets = getMegaNeonUnicornsNeedUpgrade()
    local flyPotions = getFlyPotions()
    local ridePotions = getRidePotions()

    print("========== STEP " .. step .. " ==========")

    local pet = pets[1]
    local flyPotion = flyPotions[1]
    local ridePotion = ridePotions[1]

    if pet then
        local props = pet.properties or {}
        print("PET:")
        print(
            "unique:", pet.unique,
            "| kind:", pet.kind,
            "| mega_neon:", tostring(props.mega_neon),
            "| flyable:", tostring(props.flyable),
            "| rideable:", tostring(props.rideable)
        )
    else
        print("PET: not found")
    end

    if flyPotion then
        print("FLY POTION:")
        print("unique:", flyPotion.unique, "| kind:", flyPotion.kind)
    else
        print("FLY POTION: not found")
    end

    if ridePotion then
        print("RIDE POTION:")
        print("unique:", ridePotion.unique, "| kind:", ridePotion.kind)
    else
        print("RIDE POTION: not found")
    end

    print("TOTALS:")
    print("Pets need upgrade:", #pets)
    print("Fly potions:", #flyPotions)
    print("Ride potions:", #ridePotions)
    print("================================")
    ageup(pet, flyPotion, ridePotion)
end

local step = 1

while true do
    printOneStep(step)
    step += 1
    task.wait(2)
end
