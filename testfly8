local clientData = require(game.ReplicatedStorage.ClientModules.Core.ClientData)

local function getPlayerData()
    return clientData.get_data()[tostring(game.Players.LocalPlayer)]
end

local function getRidePotions()
    local potions = {}
    for _, item in pairs(getPlayerData().inventory.food or {}) do
        if item.kind == "pet_riding_potion" then
            table.insert(potions, item)
        end
    end
    return potions
end

local function getFlyPotions()
    local potions = {}
    for _, item in pairs(getPlayerData().inventory.food or {}) do
        if item.kind == "pet_flying_potion" then
            table.insert(potions, item)
        end
    end
    return potions
end

local function getMegaNeonUnicornsNeedUpgrade()
    local pets = {}
    for _, pet in pairs(getPlayerData().inventory.pets or {}) do
        local props = pet.properties or {}
        if pet.kind == "unicorn" and props.mega_neon and (not props.flyable or not props.rideable) then
            table.insert(pets, pet)
        end
    end
    return pets
end

local function ageup(pet, flyPotion, ridePotion)
    if not pet then 
        warn("[ageup] pet is nil") 
        return false 
    end
    
    game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(pet.unique, {use_sound_delay = true})
    task.wait(0.2)
    
    print("===== AGEUP START =====")
    print("Pet unique:", pet.unique)
    print("Pet kind:", pet.kind)
    
    local success = true
    
    -- Fly potion
    if flyPotion then
        print("=== FLY POTION ===")
        print("Fly potion unique:", flyPotion.unique)
        print("Fly potion kind:", flyPotion.kind)
        game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(flyPotion.unique, {use_sound_delay = true})
        task.wait(0.2)
        
        local ok, err = pcall(function()
            game.ReplicatedStorage.API["PetObjectAPI/CreatePetObject"]:InvokeServer(
                "__Enum_PetObjectCreatorType_2", 
                { 
                    additional_consume_uniques = {}, 
                    pet_unique = pet.unique, 
                    unique_id = flyPotion.unique  -- unique_id зелья!
                }
            )
        end)
        if not ok then
            warn("Fly potion failed:", err)
            success = false
        else
            print("Fly potion applied successfully!")
        end
        task.wait(5)
    else
        print("Fly potion: nil")
    end
    
    -- Ride potion
    if ridePotion then
        print("=== RIDE POTION ===")
        print("Ride potion unique:", ridePotion.unique)
        print("Ride potion kind:", ridePotion.kind)
        game.ReplicatedStorage.API["ToolAPI/Equip"]:InvokeServer(ridePotion.unique, {use_sound_delay = true})
        task.wait(0.2)
        
        local ok, err = pcall(function()
            game.ReplicatedStorage.API["PetObjectAPI/CreatePetObject"]:InvokeServer(
                "__Enum_PetObjectCreatorType_2", 
                { 
                    additional_consume_uniques = {}, 
                    pet_unique = pet.unique, 
                    unique_id = ridePotion.unique  -- unique_id зелья!
                }
            )
        end)
        if not ok then
            warn("Ride potion failed:", err)
            success = false
        else
            print("Ride potion applied successfully!")
        end
        task.wait(5)
    else
        print("Ride potion: nil")
    end
    
    print("===== AGEUP END =====")
    return success
end

-- Основной цикл
local pets = getMegaNeonUnicornsNeedUpgrade()
local flyPotions = getFlyPotions()
local ridePotions = getRidePotions()

print("Found", #pets, "pets,", #flyPotions, "fly potions,", #ridePotions, "ride potions")

-- Проходим по каждому питомцу
for i, pet in ipairs(pets) do
    local flyPotion = flyPotions[i]
    local ridePotion = ridePotions[i]
    
    local props = pet.properties or {}
    print("=== PROCESSING PET", i, "of", #pets, "===")
    print("PET:")
    print("  unique:", pet.unique, "| kind:", pet.kind)
    print("  mega_neon:", tostring(props.mega_neon))
    print("  flyable:", tostring(props.flyable))
    print("  rideable:", tostring(props.rideable))
    
    if flyPotion then
        print("FLY POTION:")
        print("  unique:", flyPotion.unique)
    else
        print("FLY POTION: not found")
    end
    
    if ridePotion then
        print("RIDE POTION:")
        print("  unique:", ridePotion.unique)
    else
        print("RIDE POTION: not found")
    end
    
    print("--- Starting ageup for pet", i, "---")
    local success = ageup(pet, flyPotion, ridePotion)
    if success then
        print("Pet", i, "processed successfully!")
    else
        print("Pet", i, "failed!")
    end
    
    print("=== END PET", i, "===\n")
    task.wait(1)
end

print("All pets processed!")
